# 분대장 통합 실행기: 부팅하면 자동 시작, 죽으면 3초 뒤 다시 시작. 모델(STT·보고서 LLM)은 시작할 때 한 번만 읽는다.
# 로그: journalctl -u squad-leader -f      전투 로그·병사 송수신 기록: /home/arduino/squad-leader/data/leader_app/
[Unit]
Description=Squad leader app (soldier BLE link + platoon COP link + keypad + headset)
After=bluetooth.service arduino-router.service squad-ap.service
Wants=bluetooth.service arduino-router.service squad-ap.service

[Service]
User=arduino
WorkingDirectory=/home/arduino/squad-leader
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/arduino/squad-leader/.venv/bin/python -u tools/leader_app.py
StandardInput=null
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
